DATABASE_URL="postgresql://user:password@host:5432/database?sslmode=require"
JWT_SECRET="your-super-secret-jwt-key-minimum-32-characters-long"
JWT_EXPIRES_IN="24h"
PORT=5000
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:5000"

# Brevo Email Configuration (API-based, works in serverless)
BREVO_API_KEY="your-brevo-api-key-from-dashboard"
BREVO_FROM_EMAIL="your-verified-email@domain.com"
BREVO_FROM_NAME="IronPulse Gym"

# Payment Configuration
# Mode: 'test' or 'live'
PAYMENT_MODE="test"

# Active Gateway: 'mock', 'stripe', 'easypaisa', 'jazzcash'
PAYMENT_GATEWAY="mock"

# Currency: 'PKR', 'USD', etc.
PAYMENT_CURRENCY="PKR"

# Stripe Configuration (optional - only if using Stripe)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_MODE="test"

# EasyPaisa Configuration (optional - only if using EasyPaisa)
EASYPAISA_STORE_ID="your_store_id"
EASYPAISA_MERCHANT_ID="your_merchant_id"
EASYPAISA_HASH_KEY="your_hash_key"
EASYPAISA_API_URL="https://sandbox.easypaisa.com.pk/easypay"
EASYPAISA_MODE="test"

# JazzCash Configuration (optional - only if using JazzCash)
JAZZCASH_MERCHANT_ID="your_merchant_id"
JAZZCASH_PASSWORD="your_password"
JAZZCASH_SALT="your_integrity_salt"
JAZZCASH_API_URL="https://sandbox.jazzcash.com.pk/ApplicationAPI/API/Payment/DoTransaction"
JAZZCASH_RETURN_URL="http://localhost:5000/api/payment/jazzcash/callback"
JAZZCASH_MODE="test"
